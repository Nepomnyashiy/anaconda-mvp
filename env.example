# PostgreSQL
POSTGRES_USER=anaconda_user
POSTGRES_PASSWORD=replace_with_random_password
POSTGRES_DB=anaconda_db
DATABASE_URL=postgresql://anaconda_user:replace_with_random_password@db:5432/anaconda_db

# Telegram Bot API
TELEGRAM_BOT_TOKEN=replace_with_rotated_bot_token
TELEGRAM_BOT_USERNAME=replace_with_bot_username
TELEGRAM_WEBHOOK_URL=https://api.example.com/api/webhook/telegram
TELEGRAM_USE_POLLING=false

# Email IMAP
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=replace_with_email
EMAIL_IMAP_PASSWORD=replace_with_rotated_app_password
EMAIL_IMAP_SSL=true

# Application URLs
API_URL=https://api.example.com/api
FRONTEND_URL=https://app.example.com
