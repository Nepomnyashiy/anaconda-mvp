# Пример конфигурации .env для развертывания

# База данных PostgreSQL
POSTGRES_USER=anaconda_user
POSTGRES_PASSWORD={{ postgres_password | mandatory }}
POSTGRES_DB=anaconda_db
DATABASE_URL=postgresql://anaconda_user:{{ postgres_password | mandatory }}@db:5432/anaconda_db

# Telegram Bot API
TELEGRAM_BOT_TOKEN={{ telegram_bot_token | default('') }}
TELEGRAM_BOT_USERNAME={{ telegram_bot_username | default('anaconda_mvp_bot') }}
TELEGRAM_WEBHOOK_URL={{ telegram_webhook_url | default('http://localhost:8000/api/webhook/telegram') }}

# Почта Яндекс (IMAP)
EMAIL_IMAP_HOST={{ email_imap_host | default('imap.yandex.ru') }}
EMAIL_IMAP_PORT={{ email_imap_port | default('993') }}
EMAIL_IMAP_USER={{ email_imap_user | default('') }}
EMAIL_IMAP_PASSWORD={{ email_imap_password | default('') }}
EMAIL_IMAP_SSL={{ email_imap_ssl | default('true') }}

# Окружение
ENVIRONMENT={{ environment_type | default('production') }}
DEBUG={{ debug_mode | default('false') }}
